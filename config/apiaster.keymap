#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys_pt.h"

#define QWERTY 0
#define LOWER 1
#define RAISE 2
#define TESTPAD 3

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34 35 36 37
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 38 39 40 41 42 43
#define THUMBS_L 44 45 46
#define THUMBS_R 47 48 49

/ {    

    behaviors {
        hl: home_row_hold_tap_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;                // repeat on tap-into-hold
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_R THUMBS_R>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        hr: home_row_hold_tap_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;                // repeat on tap-into-hold
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_L THUMBS_L>;
            hold-trigger-on-release;             // delay positional check until key-release
        };

        td_rst: reset_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&sys_reset>, <&bootloader>;
        };
		
		&mt {
			tapping-term-ms = <300>; //  200 This is the value already set by default
		};


    };

    keymap {
        compatible = "zmk,keymap";
        
        qwerty_layer {
            display-name = "qwerty";
// ------------------------------------------------------------------------------------------------------------
//         |   1 ! |   2 @ |    3 #  |   4 $  |   5 % |              | 6 & |   7 {  |    8 (  |   9 ) |   0 } |       
//         |   Q ' |   W " |    E €  |   R    |   T ´ |              | Y \ |   U /  |    I [  |   O ] |   P ? |        
// |  ESC  | ALT/A | GUI/S | SHIFT/D | CTRL/F |   G ` |              | H | | CTRL/J | SHIFT/K | GUI/L | ALT/Ç | ENTER |
// |  < >  |   Z ª |   X º |    C    |   V    |   B   |              |  N  |   M =  |    , ;  |  . :  |  -  _ |   ~ ^ |
//                                   | LOWER  | SPACE | TAB |  | DEL |BACK | RAISE  | 
            bindings = <
          &mt EXCL N1   &mt PT_AT N2  &mt PT_HASH N3 &mt DLLR N4 &mt PRCNT N5             	&mt PT_AMPS N6 &mt PT_LBRC N7 &mt PT_LPAR N8    &mt PT_RPAR N9   	&mt PT_RBRC N0
          &mt PT_APOS Q &mt PT_DQT W  &mt PT_EURO E  &kp R       &mt PT_ACUTE T            	&mt PT_BSLH Y  &mt PT_FSLH U  &mt PT_LBKT I     &mt PT_RBKT O    	&mt PT_EXCL P
&kp ESC   &hl LALT A    &hl LGUI S    &hl LSHFT D 	 &hl LCTRL F &mt PT_GRAVE G                   	&mt PT_PIPE H  &hr RCTRL J    &hr RSHFT K		  &hr RGUI L 		&hr RALT PT_C_CEDILLA  &kp ENTER
&mt GT LT &mt PT_ORDF Z &mt PT_ORDM X &kp C       	 &kp V       &kp B                   	&kp N          &mt PT_EQUAL M &mt PT_SEMI COMMA &mt PT_COLON DOT  &mt PT_UNDER PT_MINUS  &mt PT_CARET PT_TILDE
												     &mo LOWER   &kp SPACE &kp TAB  &kp DEL &kp BSPC       &mo RAISE
            >;
        };


        lower_layer {
            display-name = "lower";
// ------------------------------------------------------------------------------------------------------------
//         |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7  |  F8  |  F9  |  F10  |       
//         |     |  ^  |      |      |      |                   |      |  7   |   8  |   9  |  * /  |      
// |       |  <- |  v  |  ->  |      |      |                   |  =   |  4   |   5  |   6  |   -   |  F11  |
// |       |     |     |      |      |      |                   |  0   |  1   |   2  |   3  |   +   |  F12  |
//                            |      |      |    |         |  , |  .   |      |              
            bindings = <
         &kp F1        &kp F2      &kp F3         &kp F4         &kp F5                    		&kp F6        &kp F7         &kp F8      &kp F9     &kp F10   
         &trans        &kp UP      &trans         &kp N4         &kp N5                     	&kp N6        &kp PT_N7      &kp PT_N8   &kp PT_N9  &mt PT_FSLH PT_STAR     
&trans   &kp LEFT      &kp DOWN    &kp RIGHT      &hl LCTRL DLLR &kp PRCNT                  	&kp PT_EQUAL  &kp PT_N4      &kp PT_N5   &kp PT_N6  &kp PT_MINUS     &kp F11
&trans   &trans        &trans      &trans         &kp LBRC       &kp RBRC                   	&kp PT_N0     &kp PT_N1      &kp PT_N2   &kp PT_N3  &kp PT_PLUS      &kp F12
                                                  &trans         &trans   &trans  &kp PT_COMMA  &kp PT_DOT    &trans     
            >;
        };


        raise_layer {
            display-name = "raise";
// ------------------------------------------------------------------------------------------------------------
//         | MUTE | VOL-   |  VOL+   | BRI+        |  BRI-  |                 |PRNTSCR|      |       |  INS  |   HOME   | 
//         | PREV | REWIND | PAUSE   | FASTFORWARD |  NEXT  |                 |       |      |       |       |   PGUP   |       
// | CAPS  |      |        |         |             | studio |                 |       |      |       |       |   PGDN   | off     |
// | reset |      | TESTPAD| QWERTY  |             |        |                 |  boot |      |       | POWER |   END    | reset   |
//                                   |             |        |      | | studio |       |      |
            bindings = <
           &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &kp C_BRI_UP &kp  C_BRI_DN                &kp PSCRN    &trans       &trans       &kp INS      &kp HOME                 
           &kp C_PREV &kp C_RW     &kp C_PP     &kp C_FF     &kp C_NEXT                   &trans       &trans       &trans       &trans       &kp PG_UP
&kp CLCK   &trans     &trans       &trans       &trans       &studio_unlock               &trans       &trans       &trans       &kp K_CMENU  &kp PG_DN    &soft_off
&sys_reset &trans     &tog TESTPAD &tog QWERTY  &trans       &trans                       &bootloader  &trans       &trans       &kp C_PWR    &kp END      &sys_reset
                                                &trans       &trans &trans      &studio_unlock   &trans    &trans 
            >;
        };
		
					
        testpad_layer {
            display-name = "testpad";
// ------------------------------------------------------------------------------------------------------------
//         |   |   |    |   |   |                |    |     |      |    |    | 
//         |   |   |    |   |   |                |    |     |      |    |    |       
// |   |   |   |   |    |   |   |                |    |     |      |    |    |    |
// |   |   |   |   |    |   |   |                |    |     |      |    |    |    |
//                      |   |   |   |       |    |    |     |
            bindings = <
           &trans     &trans       &trans        &trans     &trans              	  &trans    &trans   &trans   &trans   &trans                
           &trans     &trans       &trans        &trans     &trans             		  &trans    &trans   &trans   &trans   &trans 
&trans     &trans     &trans       &trans        &trans     &mt COMMA SEMI         	  &trans    &trans   &trans   &trans   &trans     &trans 
&trans     &trans     &to LOWER    &tog QWERTY   &to RAISE  &mt A B            		  &trans    &trans   &trans   &trans   &trans     &trans 
                                                 &trans     &trans   &trans   &trans  &trans    &trans 
            >;
        };	
		
		
		
        extra1 {
            status = "reserved";
        };

        extra2 {
            status = "reserved";
        };

        extra3 {
            status = "reserved";
        };

        extra4 {
            status = "reserved";
        };

        extra5 {
            status = "reserved";
        };
    };
};